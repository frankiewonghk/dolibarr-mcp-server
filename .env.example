# Copy to .env for local use (never commit .env).
# On a server, keep these settings in a root-only file such as /etc/dolibarr-mcp/env.
# Put values with spaces in double quotes.

# --- Dolibarr ---------------------------------------------------------------
# Base URL of the Dolibarr site, without /api/index.php.
DOLIBARR_URL=https://erp.example.com

# Display name, shown to the agent and on the sign-in page.
DOLIBARR_NAME="Example Company ERP"

# "all", or a comma-separated list of:
# core, thirdparties, products, sales, invoices, purchasing, stock,
# production, projects, tickets, agenda
DOLIBARR_TOOLSETS=all

# guarded = write tools available, irreversible steps need confirmation
# off     = read-only for every connection
DOLIBARR_WRITE_MODE=guarded

#DOLIBARR_TIMEOUT_MS=30000

# --- stdio mode ---------------------------------------------------------------
# API key of the Dolibarr user a local stdio process acts as.
DOLIBARR_API_KEY=

# --- http mode ----------------------------------------------------------------
# Listener; publish it over HTTPS through a reverse proxy.
MCP_HOST=127.0.0.1
MCP_PORT=3900
# Public address of this server as clients see it (https, no trailing slash).
# For local testing: http://localhost:3900
MCP_PUBLIC_URL=https://mcp.example.com
# Encrypts the stored Dolibarr API keys. Generate with: openssl rand -hex 32
# Changing it later invalidates every sign-in and token.
MCP_SECRET_KEY=
# Where OAuth clients, tokens and the audit log are kept.
MCP_DB_PATH=./data/dolibarr-mcp.sqlite
# Optional (defaults shown).
#MCP_ALLOWED_HOSTS=localhost,127.0.0.1
#MCP_TRUST_PROXY=loopback
#MCP_ACCESS_TTL_MIN=60
#MCP_REFRESH_TTL_DAYS=30
#MCP_AUDIT_KEEP_DAYS=365
